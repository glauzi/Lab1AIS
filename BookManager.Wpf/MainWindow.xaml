<Window x:Class="BookManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление книгами (MVVM)"
        Height="472"
        Width="900"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Row="0"
                  Grid.Column="0"
                  ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="50"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="Title"
                                    Binding="{Binding Title}"
                                    Width="*" />
                <DataGridTextColumn Header="Author"
                                    Binding="{Binding Author}"
                                    Width="*" />
                <DataGridTextColumn Header="Genre"
                                    Binding="{Binding Genre}"
                                    Width="*" />
                <DataGridTextColumn Header="Year"
                                    Binding="{Binding Year}"
                                    Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Vertical"
                    Width="260"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

            <GroupBox Header="Данные книги"
                      Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <TextBlock Text="Title:" Margin="0,0,0,2" />
                    <TextBox Text="{Binding BookTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,5" />

                    <TextBlock Text="Author:" Margin="0,0,0,2" />
                    <TextBox Text="{Binding BookAuthor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,5" />

                    <TextBlock Text="Genre:" Margin="0,0,0,2" />
                    <TextBox Text="{Binding BookGenre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,5" />

                    <TextBlock Text="Year:" Margin="0,0,0,2" />
                    <TextBox Text="{Binding BookYearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Фильтр"
                      Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <TextBlock Text="Книги после года:" Margin="0,0,0,2" />
                    <TextBox Text="{Binding YearFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Left">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="Добавить"
                            Width="80"
                            Margin="0,0,5,0"
                            Command="{Binding AddBookCommand}" />

                    <Button Content="Обновить"
                            Width="80"
                            Margin="0,0,5,0"
                            Command="{Binding UpdateBookCommand}" />

                    <Button Content="Удалить"
                            Width="80"
                            Margin="0,0,5,0"
                            Command="{Binding DeleteBookCommand}" />
                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,5,0,0">
                    <Button Content="Найти &gt; год"
                            Width="95"
                            Margin="0,0,5,0"
                            Command="{Binding FindBooksAfterYearCommand}" />

                    <Button Content="Группировать"
                            Width="100"
                            Command="{Binding GroupByGenreCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="0,5,0,0">
                    <Button Content="Сброс фильтра"
                Width="110"
                Command="{Binding ResetFilterCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,10,0,0"
                   Foreground="Gray" />
    </Grid>
</Window>
